# Discord Configuration
DISCORD_API_TOKEN=your_discord_bot_token_here

# Logging
LOG_LEVEL=NOTSET

# HTTP Server Port
PORT=3001

# AI Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Digital Ocean Container Registry (optional)
DOCR_ACCESS_TOKEN=your_docr_token_here

# TTS Configuration
TTS_PROVIDER=local
LOCAL_TTS_VOICE=Microsoft David Desktop

# ElevenLabs TTS (optional)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Piper TTS Configuration (optional - for Docker setup)
# Leave commented out for local development, uncomment for Docker
# PIPER_URL=http://piper:5000