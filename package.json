{
  "name": "zenbot",
  "version": "0.1.0",
  "description": "A sardonic Discord bot: Zenbot - concise, spicy AI guidance with voice and conversation memory",
  "main": "dist/app.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node dist/app.js",
    "dev": "nodemon src/app.ts",
    "tts": "ts-node src/scripts/tts.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:multi-personality": "vitest run test/multi-personality.test.ts",
    "demo:multi-personality": "ts-node src/demo-multi-personality.ts",
    "coverage": "vitest run --coverage",
    "build": "tsc",
    "lint": "prettier --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.61.0",
    "@discordjs/opus": "^0.11.0",
    "@discordjs/voice": "^0.19.2",
    "@google/generative-ai": "^0.24.1",
    "discord.js": "^14.17",
    "dotenv": "^16.0.3",
    "fastify": "^5.12.8",
    "ffmpeg-static": "^5.1.0",
    "libsodium-wrappers": "^0.7.11",
    "openai": "^5.19.1",
    "opusscript": "^0.0.8",
    "say": "^0.16.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@vitest/ui": "^3.2.7",
    "nodemon": "^3.1.14",
    "prettier": "^3.5.3",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tijmenvanegmond/zenbot.git"
  },
  "keywords": [
    "discord",
    "bot",
    "voice",
    "zen",
    "zenyatta",
    "overwatch",
    "philosophy",
    "tts",
    "harmony",
    "tranquility"
  ],
  "authors": [
    "Tijmen van Egmond",
    "Claude (Anthropic's AI Assistant)"
  ],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/tijmenvanegmond/zenbot/issues"
  },
  "homepage": "https://github.com/tijmenvanegmond/zenbot#readme",
  "allowScripts": {
    "@discordjs/opus@0.11.0": true,
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "@discordjs/node-pre-gyp": {
      "tar": "^7.5.23"
    }
  }
}
